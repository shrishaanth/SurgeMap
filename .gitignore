__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
.ipynb_checkpoints/

# Raw taxi trip files: large and downloadable from NYC TLC
/data/raw/

# Every processed dataset except January, which the simulator and the app need, is rebuilt on demand
/data/processed/*
!/data/processed/january_2024/
/data/processed/january_2024/features.npy
/data/processed/january_2024/A_sym.npy
/data/processed/january_2024/adjacency.npy
/data/processed/january_2024/edge_index.npy

# Intermediate files: per-episode cache of the simulation study, staged forecasts, prediction caches
/outputs/results/*.runs.jsonl
/outputs/results/*.npz
/outputs/forecasts_four_months/
/outputs/cache/
